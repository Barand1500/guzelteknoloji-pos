  baslangic DateTime @db.Date
  bitis     DateTime @db.Date
  isletme   Isletme  @relation(fields: [isletmeId], references: [id], onDelete: Cascade)

  @@index([isletmeId, baslangic], map: "ozel_tatiller_isletme_tarih_indeks")
  @@map("ozel_tatiller")
