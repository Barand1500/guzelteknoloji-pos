  degisken     String   @default("") @db.VarChar(120)
  sira         Int      @default(0)
  sablon       SiteSablonDegiskeni @relation(fields: [degiskenId], references: [id], onDelete: Cascade)

  @@index([degiskenId, sira], map: "site_sablon_alan_degisken_sira_indeks")
