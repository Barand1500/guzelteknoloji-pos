  ad        String   @db.VarChar(120)
  sira      Int      @default(0)
  isletme   Isletme  @relation(fields: [isletmeId], references: [id], onDelete: Cascade)

  @@unique([isletmeId, ad], map: "cari_tipleri_ad_tekil")
