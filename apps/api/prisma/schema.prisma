// MySQL 8+ / MariaDB 10.6+ için şema.
// Kayıt kimlikleri otomatik artan sayısal değerlerdir.
// Tüm zaman damgaları UTC olarak saklanır.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

enum KullaniciDurumu {
  AKTIF      @map("ACTIVE")
  DEVRE_DISI @map("DISABLED")
}

enum GirisSaglayicisi {
  GOOGLE
  APPLE
}

enum GirisYontemi {
  EPOSTA @map("EMAIL")
  GOOGLE
  APPLE
}

model Kullanici {
  kimlik                Int             @id @default(autoincrement()) @map("kimlik")
  /// Normalize edilmiş (trim + küçük harf) e-posta. OAuth-only kullanıcılarda da doldurulur.
  eposta                String?         @unique(map: "kullanicilar_eposta_tekil") @map("eposta") @db.VarChar(254)
  epostaDogrulamaZamani DateTime?       @map("eposta_dogrulama_zamani")
  gorunenAd             String?         @map("gorunen_ad") @db.VarChar(120)
  profilResmiAdresi     String?         @map("profil_resmi_adresi") @db.VarChar(2048)
  durum                 KullaniciDurumu @default(AKTIF) @map("durum")
  olusturmaZamani       DateTime        @default(now()) @map("olusturma_zamani")
  guncellemeZamani      DateTime        @updatedAt @map("guncelleme_zamani")

  sonGirisYontemi GirisYontemi? @map("son_giris_yontemi")
  sonGirisZamani  DateTime?     @map("son_giris_zamani")

  /// Şifresiz hesaplarda boş; Argon2id PHC hash'i API kullanıcı yanıtlarına alınmaz.
  sifreHash             String?        @map("sifre_hash") @db.VarChar(255)
  sifreOlusturmaZamani  DateTime?      @map("sifre_olusturma_zamani")
  sifreGuncellemeZamani DateTime?      @map("sifre_guncelleme_zamani")
  girisKimlikleri       GirisKimligi[]
  oturumlar             Oturum[]
  stokSecenekleri       StokSecenegi[]
  stokKartlari          StokKarti[]
  markalar              Marka[]

  @@map("kullanicilar")
}

model GirisKimligi {
  kimlik                    Int              @id @default(autoincrement()) @map("kimlik")
  kullaniciKimligi          Int              @map("kullanici_kimligi")
  saglayici                 GirisSaglayicisi @map("saglayici")
  /// Sağlayıcının değişmez kullanıcı kimliği (Google için `sub`). E-posta DEĞİL.
  saglayiciKullaniciKimligi String           @map("saglayici_kullanici_kimligi") @db.VarChar(255)
  /// Bilgi amaçlı; eşleştirme için kullanılmaz.
  eposta                    String?          @map("eposta") @db.VarChar(254)
  sonKullanimZamani         DateTime?        @map("son_kullanim_zamani")
  olusturmaZamani           DateTime         @default(now()) @map("olusturma_zamani")
  guncellemeZamani          DateTime         @updatedAt @map("guncelleme_zamani")

  kullanici Kullanici @relation(fields: [kullaniciKimligi], references: [kimlik], onDelete: Cascade, map: "giris_kimlikleri_kullanici_baglantisi")

  @@unique([saglayici, saglayiciKullaniciKimligi], map: "giris_kimlikleri_saglayici_kullanici_tekil")
  @@index([kullaniciKimligi], map: "giris_kimlikleri_kullanici_indeks")
  @@map("giris_kimlikleri")
}

model Oturum {
  kimlik                Int           @id @default(autoincrement()) @map("kimlik")
  kullaniciKimligi      Int           @map("kullanici_kimligi")
  /// Cookie'deki opak token'ın SHA-256 hash'i (hex). Ham token veritabanında tutulmaz.
  girisYontemi          GirisYontemi? @map("giris_yontemi")
  oturumAnahtariHash    String        @unique(map: "oturumlar_anahtar_hash_tekil") @map("oturum_anahtari_hash") @db.Char(64)
  gecerlilikBitisZamani DateTime      @map("gecerlilik_bitis_zamani")
  sonGorulmeZamani      DateTime      @default(now()) @map("son_gorulme_zamani")
  iptalZamani           DateTime?     @map("iptal_zamani")
  ipAdresi              String?       @map("ip_adresi") @db.VarChar(45)
  istemciBilgisi        String?       @map("istemci_bilgisi") @db.VarChar(512)
  olusturmaZamani       DateTime      @default(now()) @map("olusturma_zamani")

  kullanici Kullanici @relation(fields: [kullaniciKimligi], references: [kimlik], onDelete: Cascade, map: "oturumlar_kullanici_baglantisi")

  @@index([kullaniciKimligi], map: "oturumlar_kullanici_indeks")
  @@index([gecerlilikBitisZamani], map: "oturumlar_gecerlilik_indeks")
  @@map("oturumlar")
}

/// Kullanıcıya ait sabit/özel seçimler. Kullanılmış seçenekler silinmez, pasifleştirilir.
model StokSecenegi {
  kimlik            Int                @id @default(autoincrement()) @map("kimlik")
  kullaniciKimligi  Int                @map("kullanici_kimligi")
  listeTuru         String             @map("liste_turu") @db.VarChar(30)
  secenekKodu       String             @map("secenek_kodu") @db.VarChar(100)
  secenekAdi        String             @map("secenek_adi") @db.VarChar(120)
  adHash            String             @map("ad_hash") @db.Char(64)
  silinebilir       Boolean            @default(false) @map("silinebilir")
  etkin             Boolean            @default(true) @map("etkin")
  sira              Int                @default(0) @map("sira")
  olusturmaZamani   DateTime           @default(now()) @map("olusturma_zamani")
  kullanici         Kullanici          @relation(fields: [kullaniciKimligi], references: [kimlik], onDelete: Cascade, map: "stok_secenekleri_kullanici_baglantisi")
  tipKartlari       StokKarti[]        @relation("StockType")
  neviKartlari      StokKarti[]        @relation("StockKind")
  departmanKartlari StokKarti[]        @relation("StockDepartment")
  vergiKartlari     StokKarti[]        @relation("StockTax")
  fiyatListeleri    StokFiyatListesi[]
  birimler          StokBirimi[]

  @@unique([kullaniciKimligi, listeTuru, secenekKodu], map: "stok_secenekleri_kod_tekil")
  @@unique([kullaniciKimligi, listeTuru, adHash], map: "stok_secenekleri_ad_tekil")
  @@map("stok_secenekleri")
}

/// Marka bilgileri tek kayıttadır ve oturumdaki kullanıcıya aittir.
model Marka {
  kimlik           Int         @id @default(autoincrement()) @map("kimlik")
  kullaniciKimligi Int         @map("kullanici_kimligi")
  markaKodu        String      @map("marka_kodu") @db.VarChar(100)
  markaAdi         String      @map("marka_adi") @db.VarChar(120)
  adHash           String      @map("ad_hash") @db.Char(64)
  etkin            Boolean     @default(true) @map("etkin")
  sira             Int         @default(0) @map("sira")
  olusturmaZamani  DateTime    @default(now()) @map("olusturma_zamani")
  aciklama         String      @map("aciklama") @db.Text
  logoVerisi       Bytes?      @map("logo_verisi") @db.MediumBlob
  logoDosyasi      String?     @map("logo_dosyasi") @db.VarChar(255)
  logoHash         String?     @map("logo_hash") @db.Char(64)
  seoBasligi       String      @map("seo_basligi") @db.VarChar(250)
  seoAciklamasi    String      @map("seo_aciklamasi") @db.VarChar(1000)
  guncellemeZamani DateTime    @updatedAt @map("guncelleme_zamani")
  kullanici        Kullanici   @relation(fields: [kullaniciKimligi], references: [kimlik], onDelete: Cascade, map: "markalar_kullanici_baglantisi")
  stokKartlari     StokKarti[]

  @@unique([kullaniciKimligi, markaKodu], map: "markalar_kod_tekil")
  @@unique([kullaniciKimligi, adHash], map: "markalar_ad_tekil")
  @@map("markalar")
}

model StokKarti {
  kimlik               Int                @id @default(autoincrement()) @map("kimlik")
  kullaniciKimligi     Int                @map("kullanici_kimligi")
  kayitIstegiKimligi   String             @map("kayit_istegi_kimligi") @db.Char(36)
  kayitIstegiHash      String             @map("kayit_istegi_hash") @db.Char(64)
  stokKodu             String?            @map("stok_kodu") @db.VarChar(100)
  stokAdi              String?            @map("stok_adi") @db.VarChar(250)
  stokTipiKimligi      Int                @map("stok_tipi_kimligi")
  stokNeviKimligi      Int                @map("stok_nevi_kimligi")
  markaKimligi         Int?               @map("marka_kimligi")
  kdvDepartmaniKimligi Int?               @map("kdv_departmani_kimligi")
  digerVergiKimligi    Int?               @map("diger_vergi_kimligi")
  envanterTakibi       String             @map("envanter_takibi") @db.VarChar(10)
  altLimit             Decimal?           @map("alt_limit") @db.Decimal(18, 6)
  ustLimit             Decimal?           @map("ust_limit") @db.Decimal(18, 6)
  seriNoZorunlu        Boolean            @default(false) @map("seri_no_zorunlu")
  seriNoOneki          String?            @map("seri_no_oneki") @db.VarChar(100)
  lotZorunlu           Boolean            @default(false) @map("lot_zorunlu")
  sktTakibi            Boolean            @default(false) @map("skt_takibi")
  lotOneki             String?            @map("lot_oneki") @db.VarChar(100)
  sktZorunlu           Boolean            @default(false) @map("skt_zorunlu")
  rafOmruGun           Int?               @map("raf_omru_gun")
  riskSuresiGun        Int?               @map("risk_suresi_gun")
  gtipKodu             String?            @map("gtip_kodu") @db.VarChar(32)
  mensei               String?            @map("mensei") @db.VarChar(40)
  olusturmaZamani      DateTime           @default(now()) @map("olusturma_zamani")
  guncellemeZamani     DateTime           @updatedAt @map("guncelleme_zamani")
  kullanici            Kullanici          @relation(fields: [kullaniciKimligi], references: [kimlik], onDelete: Cascade, map: "stok_kartlari_kullanici_baglantisi")
  stokTipi             StokSecenegi       @relation("StockType", fields: [stokTipiKimligi], references: [kimlik], map: "stok_kartlari_tip_baglantisi")
  stokNevi             StokSecenegi       @relation("StockKind", fields: [stokNeviKimligi], references: [kimlik], map: "stok_kartlari_nevi_baglantisi")
  marka                Marka?             @relation(fields: [markaKimligi], references: [kimlik], map: "stok_kartlari_marka_baglantisi")
  kdvDepartmani        StokSecenegi?      @relation("StockDepartment", fields: [kdvDepartmaniKimligi], references: [kimlik], map: "stok_kartlari_departman_baglantisi")
  digerVergi           StokSecenegi?      @relation("StockTax", fields: [digerVergiKimligi], references: [kimlik], map: "stok_kartlari_vergi_baglantisi")
  fiyatListeleri       StokFiyatListesi[]

  @@unique([kullaniciKimligi, stokKodu], map: "stok_kartlari_kullanici_kod_tekil")
  @@unique([kullaniciKimligi, kayitIstegiKimligi], map: "stok_kartlari_kayit_istegi_tekil")
  @@map("stok_kartlari")
}

model StokFiyatListesi {
  kimlik              Int          @id @default(autoincrement()) @map("kimlik")
  stokKartiKimligi    Int          @map("stok_karti_kimligi")
  fiyatListesiKimligi Int          @map("fiyat_listesi_kimligi")
  sira                Int          @map("sira")
  stokKarti           StokKarti    @relation(fields: [stokKartiKimligi], references: [kimlik], onDelete: Cascade, map: "stok_fiyat_listeleri_kart_baglantisi")
  secenek             StokSecenegi @relation(fields: [fiyatListesiKimligi], references: [kimlik], map: "stok_fiyat_listeleri_secenek_baglantisi")
  birimler            StokBirimi[]

  @@unique([stokKartiKimligi, fiyatListesiKimligi], map: "stok_fiyat_listeleri_kart_liste_tekil")
  @@map("stok_fiyat_listeleri")
}

model StokBirimi {
  kimlik                  Int              @id @default(autoincrement()) @map("kimlik")
  stokFiyatListesiKimligi Int              @map("stok_fiyat_listesi_kimligi")
  birimKimligi            Int              @map("birim_kimligi")
  sira                    Int              @map("sira")
  carpan                  Decimal          @map("carpan") @db.Decimal(18, 6)
  anaBirim                Boolean          @map("ana_birim")
  varsayilanBirim         Boolean          @map("varsayilan_birim")
  agirlik                 Decimal?         @map("agirlik") @db.Decimal(18, 6)
  agirlikBirimi           String           @map("agirlik_birimi") @db.VarChar(2)
  hacimDesi               Decimal?         @map("hacim_desi") @db.Decimal(18, 6)
  aciklama                String?          @map("aciklama") @db.VarChar(1000)
  fiyatListesi            StokFiyatListesi @relation(fields: [stokFiyatListesiKimligi], references: [kimlik], onDelete: Cascade, map: "stok_birimleri_liste_baglantisi")
  secenek                 StokSecenegi     @relation(fields: [birimKimligi], references: [kimlik], map: "stok_birimleri_secenek_baglantisi")
  fiyatlar                StokFiyati[]
  barkodlar               StokBarkodu[]

  @@index([stokFiyatListesiKimligi], map: "stok_birimleri_liste_indeks")
  @@map("stok_birimleri")
}

model StokFiyati {
  kimlik            Int            @id @default(autoincrement()) @map("kimlik")
  stokBirimiKimligi Int            @map("stok_birimi_kimligi")
  fiyatYonu         String         @map("fiyat_yonu") @db.VarChar(5)
  girilenFiyat      Decimal?       @map("girilen_fiyat") @db.Decimal(18, 6)
  paraBirimi        String         @map("para_birimi") @db.Char(3)
  iskontoOrani      Decimal?       @map("iskonto_orani") @db.Decimal(18, 6)
  kdvOrani          Decimal?       @map("kdv_orani") @db.Decimal(18, 6)
  kdvDahilGirildi   Boolean        @map("kdv_dahil_girildi")
  stokBirimi        StokBirimi     @relation(fields: [stokBirimiKimligi], references: [kimlik], onDelete: Cascade, map: "stok_fiyatlari_birim_baglantisi")
  ekFiyatlar        StokEkFiyati[]

  @@unique([stokBirimiKimligi, fiyatYonu], map: "stok_fiyatlari_birim_yon_tekil")
  @@map("stok_fiyatlari")
}

model StokEkFiyati {
  kimlik            Int        @id @default(autoincrement()) @map("kimlik")
  stokFiyatiKimligi Int        @map("stok_fiyati_kimligi")
  sira              Int        @map("sira")
  aciklama          String?    @map("aciklama") @db.VarChar(250)
  tutar             Decimal?   @map("tutar") @db.Decimal(18, 6)
  iskontoOrani      Decimal?   @map("iskonto_orani") @db.Decimal(18, 6)
  paraBirimi        String     @map("para_birimi") @db.Char(3)
  stokFiyati        StokFiyati @relation(fields: [stokFiyatiKimligi], references: [kimlik], onDelete: Cascade, map: "stok_ek_fiyatlari_fiyat_baglantisi")

  @@index([stokFiyatiKimligi], map: "stok_ek_fiyatlari_fiyat_indeks")
  @@map("stok_ek_fiyatlari")
}

model StokBarkodu {
  kimlik            Int        @id @default(autoincrement()) @map("kimlik")
  stokBirimiKimligi Int        @map("stok_birimi_kimligi")
  barkodTuru        String     @map("barkod_turu") @db.VarChar(10)
  barkod            String     @map("barkod") @db.VarChar(128)
  stokBirimi        StokBirimi @relation(fields: [stokBirimiKimligi], references: [kimlik], onDelete: Cascade, map: "stok_barkodlari_birim_baglantisi")

  @@unique([stokBirimiKimligi, barkod], map: "stok_barkodlari_birim_kod_tekil")
  @@index([barkod], map: "stok_barkodlari_kod_indeks")
  @@map("stok_barkodlari")
}
