  fiyat     Decimal  @db.Decimal(12, 2)
  birimBasi Boolean  @default(false) @map("birim_basi")
  firma     KargoFirmasi @relation(fields: [firmaId], references: [id], onDelete: Cascade)

  @@index([firmaId, tur, sira], map: "kargo_fiyat_firma_tur_sira_indeks")
  @@map("kargo_fiyat_basamaklari")
}

model KargoLokasyonu {
