// MySQL 8+ / MariaDB 10.6+ için şema.
// Kayıt kimlikleri otomatik artan sayısal değerlerdir.
// Tüm zaman damgaları UTC olarak saklanır.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

enum KullaniciDurumu {
  AKTIF      @map("ACTIVE")
  DEVRE_DISI @map("DISABLED")
}

enum GirisSaglayicisi {
  GOOGLE
  APPLE
}

enum GirisYontemi {
  EPOSTA @map("EMAIL")
  GOOGLE
  APPLE
}

model Kullanici {
  ownedBusiness Isletme? @relation("BusinessOwner")
  businessMember IsletmeUyesi?
  activityLogs IslemKaydi[]

  kimlik                Int             @id @default(autoincrement()) @map("id")
  /// Normalize edilmiş (trim + küçük harf) e-posta. OAuth-only kullanıcılarda da doldurulur.
  eposta                String?         @unique(map: "kullanicilar_eposta_tekil") @map("eposta") @db.VarChar(254)
  epostaDogrulamaZamani DateTime?       @map("eposta_dogrulama_zamani")
  gorunenAd             String?         @map("gorunen_ad") @db.VarChar(120)
  profilResmiAdresi     String?         @map("profil_resmi_adresi") @db.VarChar(2048)
  durum                 KullaniciDurumu @default(AKTIF) @map("durum")
  olusturmaZamani       DateTime        @default(now()) @map("olusturma_zamani")
  guncellemeZamani      DateTime        @updatedAt @map("guncelleme_zamani")

  sonGirisYontemi GirisYontemi? @map("son_giris_yontemi")
  sonGirisZamani  DateTime?     @map("son_giris_zamani")

  /// Şifresiz hesaplarda boş; Argon2id PHC hash'i API kullanıcı yanıtlarına alınmaz.
  sifreHash             String?        @map("sifre_hash") @db.VarChar(255)
  sifreOlusturmaZamani  DateTime?      @map("sifre_olusturma_zamani")
  sifreGuncellemeZamani DateTime?      @map("sifre_guncelleme_zamani")
  girisKimlikleri       GirisKimligi[]
  oturumlar             Oturum[]
  stokSecenekleri       StokSecenegi[]
  stokKartlari          StokKarti[]
  markalar              Marka[]
  kategoriler           Kategori[]
  firsatlar             Firsat[]
  ozellikSablonlari      OzellikSablonu[]

  @@map("kullanicilar")
}

model GirisKimligi {
  kimlik                    Int              @id @default(autoincrement()) @map("id")
  kullaniciKimligi          Int              @map("kullanici_id")
  saglayici                 GirisSaglayicisi @map("saglayici")
  /// Sağlayıcının değişmez kullanıcı kimliği (Google için `sub`). E-posta DEĞİL.
  saglayiciKullaniciKimligi String           @map("saglayici_kullanici_id") @db.VarChar(255)
  /// Bilgi amaçlı; eşleştirme için kullanılmaz.
  eposta                    String?          @map("eposta") @db.VarChar(254)
  sonKullanimZamani         DateTime?        @map("son_kullanim_zamani")
  olusturmaZamani           DateTime         @default(now()) @map("olusturma_zamani")
  guncellemeZamani          DateTime         @updatedAt @map("guncelleme_zamani")

  kullanici Kullanici @relation(fields: [kullaniciKimligi], references: [kimlik], onDelete: Cascade, map: "giris_kimlikleri_kullanici_baglantisi")

  @@unique([saglayici, saglayiciKullaniciKimligi], map: "giris_kimlikleri_saglayici_kullanici_tekil")
  @@index([kullaniciKimligi], map: "giris_kimlikleri_kullanici_indeks")
  @@map("giris_kimlikleri")
}

model Oturum {
  kimlik                Int           @id @default(autoincrement()) @map("id")
  kullaniciKimligi      Int           @map("kullanici_id")
  /// Cookie'deki opak token'ın SHA-256 hash'i (hex). Ham token veritabanında tutulmaz.
  girisYontemi          GirisYontemi? @map("giris_yontemi")
  oturumAnahtariHash    String        @unique(map: "oturumlar_anahtar_hash_tekil") @map("oturum_anahtari_hash") @db.Char(64)
  gecerlilikBitisZamani DateTime      @map("gecerlilik_bitis_zamani")
  sonGorulmeZamani      DateTime      @default(now()) @map("son_gorulme_zamani")
  iptalZamani           DateTime?     @map("iptal_zamani")
  ipAdresi              String?       @map("ip_adresi") @db.VarChar(45)
  istemciBilgisi        String?       @map("istemci_bilgisi") @db.VarChar(512)
  olusturmaZamani       DateTime      @default(now()) @map("olusturma_zamani")

  kullanici Kullanici @relation(fields: [kullaniciKimligi], references: [kimlik], onDelete: Cascade, map: "oturumlar_kullanici_baglantisi")

  @@index([kullaniciKimligi], map: "oturumlar_kullanici_indeks")
  @@index([gecerlilikBitisZamani], map: "oturumlar_gecerlilik_indeks")
  @@map("oturumlar")
}

/// E-postaya gönderilen tek kullanımlık giriş kodları. Kullanıcıya bağlı DEĞİLDİR (hesap kod
/// doğrulanınca oluşur). Düz e-posta ve düz kod saklanmaz: ikisi de HMAC hash'tir.
model EpostaGirisKodu {
  kimlik                Int      @id @default(autoincrement()) @map("id")
  /// HMAC-SHA256(gizli anahtar, e-posta) hex.
  epostaHash            String   @map("eposta_hash") @db.Char(64)
  /// HMAC-SHA256(gizli anahtar, "e-posta:kod") hex.
  kodHash               String   @map("kod_hash") @db.Char(64)
  gecerlilikBitisZamani DateTime @map("gecerlilik_bitis_zamani")
  /// Yanlış deneme sayısı; sınır aşılınca kod geçersiz olur.
  denemeSayisi          Int      @default(0) @map("deneme_sayisi")
  olusturmaZamani       DateTime @default(now()) @map("olusturma_zamani")

  @@index([epostaHash, olusturmaZamani], map: "eposta_kodlari_eposta_olusturma_indeks")
  @@index([olusturmaZamani], map: "eposta_kodlari_olusturma_indeks")
  @@map("eposta_giris_kodlari")
}

/// Kullanıcıya ait sabit/özel seçimler. Kullanılmış seçenekler silinmez, pasifleştirilir.
model StokSecenegi {
  kimlik            Int                @id @default(autoincrement()) @map("id")
  kullaniciKimligi  Int                @map("kullanici_id")
  listeTuru         String             @map("liste_turu") @db.VarChar(30)
  secenekKodu       String             @map("secenek_kodu") @db.VarChar(100)
  secenekAdi        String             @map("secenek_adi") @db.VarChar(120)
  adHash            String             @map("ad_hash") @db.Char(64)
  silinebilir       Boolean            @default(false) @map("silinebilir")
  etkin             Boolean            @default(true) @map("etkin")
  sira              Int                @default(0) @map("sira")
  olusturmaZamani   DateTime           @default(now()) @map("olusturma_zamani")
  kullanici         Kullanici          @relation(fields: [kullaniciKimligi], references: [kimlik], onDelete: Cascade, map: "urun_secenekleri_kullanici_baglantisi")
  tipKartlari       StokKarti[]        @relation("StockType")
  urunVergileri UrunVergisi[]
  fiyatlar          StokFiyati[]
  birimler          StokBirimi[]

  @@unique([kullaniciKimligi, listeTuru, secenekKodu], map: "urun_secenekleri_kod_tekil")
  @@unique([kullaniciKimligi, listeTuru, adHash], map: "urun_secenekleri_ad_tekil")
  @@map("urun_secenekleri")
}

/// Marka bilgileri tek kayıttadır ve oturumdaki kullanıcıya aittir.
model Marka {
  kimlik           Int         @id @default(autoincrement()) @map("id")
  kullaniciKimligi Int         @map("kullanici_id")
  markaKodu        String      @map("marka_kodu") @db.VarChar(100)
  markaAdi         String      @map("marka_adi") @db.VarChar(120)
  adHash           String      @map("ad_hash") @db.Char(64)
  etkin            Boolean     @default(true) @map("etkin")
  sira             Int         @default(0) @map("sira")
  olusturmaZamani  DateTime    @default(now()) @map("olusturma_zamani")
  aciklama         String      @map("aciklama") @db.Text
  logoVerisi       Bytes?      @map("logo_verisi") @db.MediumBlob
  logoDosyasi      String?     @map("logo_dosyasi") @db.VarChar(255)
  logoHash         String?     @map("logo_hash") @db.Char(64)
  seoBasligi       String      @map("seo_basligi") @db.VarChar(250)
  seoAciklamasi    String      @map("seo_aciklamasi") @db.VarChar(1000)
  guncellemeZamani DateTime    @updatedAt @map("guncelleme_zamani")
  kullanici        Kullanici   @relation(fields: [kullaniciKimligi], references: [kimlik], onDelete: Cascade, map: "markalar_kullanici_baglantisi")
  stokKartlari     StokKarti[]

  @@unique([kullaniciKimligi, markaKodu], map: "markalar_kod_tekil")
  @@unique([kullaniciKimligi, adHash], map: "markalar_ad_tekil")
  @@map("markalar")
}

model StokKarti {
  kimlik               Int                @id @default(autoincrement()) @map("id")
  kullaniciKimligi     Int                @map("kullanici_id")
  kayitIstegiKimligi   String             @map("kayit_istegi_id") @db.Char(36)
  kayitIstegiHash      String             @map("kayit_istegi_hash") @db.Char(64)
  stokKodu             String?            @map("urun_kodu") @db.VarChar(100)
  stokAdi              String?            @map("urun_adi") @db.VarChar(250)
  stokTipiKimligi      Int                @map("urun_tipi_id")
  markaKimligi         Int?               @map("marka_id")
  satisAcik            Boolean            @default(true) @map("satisa_acik")
  stokMiktari          Decimal            @default(0) @map("stok_miktari") @db.Decimal(18, 6)
  envanterTakibi       String             @map("envanter_takibi") @db.VarChar(10)
  altLimit             Decimal?           @map("alt_limit") @db.Decimal(18, 6)
  ustLimit             Decimal?           @map("ust_limit") @db.Decimal(18, 6)
  mensei               String?            @map("mensei") @db.VarChar(40)
  olusturmaZamani      DateTime           @default(now()) @map("olusturma_zamani")
  guncellemeZamani     DateTime           @updatedAt @map("guncelleme_zamani")
  kullanici            Kullanici          @relation(fields: [kullaniciKimligi], references: [kimlik], onDelete: Cascade, map: "urunler_kullanici_baglantisi")
  stokTipi             StokSecenegi       @relation("StockType", fields: [stokTipiKimligi], references: [kimlik], map: "urunler_tip_baglantisi")
  marka                Marka?             @relation(fields: [markaKimligi], references: [kimlik], map: "urunler_marka_baglantisi")
  vergiler             UrunVergisi[]
  birimler             StokBirimi[]
  kategoriler          StokKartiKategori[]
  firsatlar            StokFirsati[]
  gorseller            StokGorseli[]
  ozellikDegerleri     StokOzellikDegeri[]
  varyantlar           StokVaryanti[]

  @@unique([kullaniciKimligi, stokKodu], map: "urunler_kullanici_kod_tekil")
  @@unique([kullaniciKimligi, kayitIstegiKimligi], map: "urunler_kayit_istegi_tekil")
  @@map("urunler")
}

/// Dosya uploads/urunler içinde özgün biçimde tutulur; ilk sıra vitrin görselidir.
model StokGorseli {
  id          Int       @id @default(autoincrement())
  stokKartiId Int       @map("urun_id")
  dosyaAdi    String    @unique @map("dosya_adi") @db.VarChar(255)
  sira        Int       @default(0)
  stokKarti   StokKarti @relation(fields: [stokKartiId], references: [kimlik], onDelete: Cascade)

  @@index([stokKartiId, sira])
  @@map("urun_gorselleri")
}

model Kategori {
  id              Int                     @id @default(autoincrement())
  kullaniciId     Int                     @map("kullanici_id")
  ustId           Int?                    @map("ust_kategori_id")
  ad              String                  @db.VarChar(120)
  aciklama        String                  @db.Text
  gorselDosyasi   String?                 @map("gorsel_dosyasi") @db.VarChar(255)
  etkin           Boolean                 @default(true)
  gizli           Boolean                 @default(false)
  seoBasligi      String                  @map("seo_basligi") @db.VarChar(250)
  seoAciklamasi   String                  @map("seo_aciklamasi") @db.VarChar(1000)
  sira            Int                     @default(0)
  kullanici       Kullanici               @relation(fields: [kullaniciId], references: [kimlik], onDelete: Cascade)
  ust             Kategori?               @relation("KategoriAgaci", fields: [ustId], references: [id], onDelete: Restrict)
  altlar          Kategori[]              @relation("KategoriAgaci")
  stokKartlari    StokKartiKategori[]
  ozellikSablonlari OzellikSablonKategori[]
  @@index([kullaniciId, ustId])
  @@map("kategoriler")
}

model StokKartiKategori {
  stokKartiId Int @map("urun_id")
  kategoriId Int @map("kategori_id")
  stokKarti StokKarti @relation(fields: [stokKartiId], references: [kimlik], onDelete: Cascade)
  kategori Kategori @relation(fields: [kategoriId], references: [id], onDelete: Cascade)
  @@id([stokKartiId, kategoriId])
  @@map("urun_kategorileri")
}

model Firsat {
  id Int @id @default(autoincrement())
  kullaniciId Int @map("kullanici_id")
  ad String @db.VarChar(120)
  ikonDosyasi String? @map("ikon_dosyasi") @db.VarChar(255)
  etkin Boolean @default(true)
  resimdeGoster Boolean @map("resimde_goster")
  konum String @db.VarChar(10)
  boyut String @db.VarChar(10)
  seoBasligi String @map("seo_basligi") @db.VarChar(250)
  seoAciklamasi String @map("seo_aciklamasi") @db.VarChar(1000)
  sira Int @default(0)
  kullanici Kullanici @relation(fields: [kullaniciId], references: [kimlik], onDelete: Cascade)
  stokKartlari StokFirsati[]
  @@index([kullaniciId, sira])
  @@map("firsatlar")
}

model StokFirsati {
  stokKartiId Int @map("urun_id")
  firsatId Int @map("firsat_id")
  stokKarti StokKarti @relation(fields: [stokKartiId], references: [kimlik], onDelete: Cascade)
  firsat Firsat @relation(fields: [firsatId], references: [id], onDelete: Cascade)
  @@id([stokKartiId, firsatId])
  @@map("urun_firsatlari")
}

model OzellikSablonu {
  id Int @id @default(autoincrement())
  kullaniciId Int @map("kullanici_id")
  ad String @db.VarChar(120)
  tumUrunler Boolean @default(false) @map("tum_urunler")
  sira Int @default(0)
  kullanici Kullanici @relation(fields: [kullaniciId], references: [kimlik], onDelete: Cascade)
  kategoriler OzellikSablonKategori[]
  gruplar OzellikGrubu[]
  @@index([kullaniciId, sira])
  @@map("ozellik_sablonlari")
}

model OzellikSablonKategori {
  sablonId Int @map("sablon_id")
  kategoriId Int @map("kategori_id")
  sablon OzellikSablonu @relation(fields: [sablonId], references: [id], onDelete: Cascade)
  kategori Kategori @relation(fields: [kategoriId], references: [id], onDelete: Cascade)
  @@id([sablonId, kategoriId])
  @@map("ozellik_sablon_kategorileri")
}

model OzellikGrubu {
  id Int @id @default(autoincrement())
  sablonId Int @map("sablon_id")
  ad String @db.VarChar(120)
  tur String @db.VarChar(10)
  filtre Boolean @default(false)
  coklu Boolean @default(false)
  varyant Boolean @default(false)
  resimdeGoster Boolean @default(false) @map("resimde_goster")
  konum String @db.VarChar(10)
  boyut String @db.VarChar(10)
  sira Int @default(0)
  sablon OzellikSablonu @relation(fields: [sablonId], references: [id], onDelete: Cascade)
  degerler OzellikDegeri[]
  @@index([sablonId, sira])
  @@map("ozellik_gruplari")
}

model OzellikDegeri {
  id Int @id @default(autoincrement())
  grupId Int @map("grup_id")
  kod String @db.VarChar(120)
  ad String @db.VarChar(120)
  renk String? @db.VarChar(7)
  gorselDosyasi String? @map("gorsel_dosyasi") @db.VarChar(255)
  sira Int @default(0)
  grup OzellikGrubu @relation(fields: [grupId], references: [id], onDelete: Cascade)
  stokKartlari StokOzellikDegeri[]
  varyantlar StokVaryantDegeri[]
  @@unique([grupId, kod])
  @@index([grupId, sira])
  @@map("ozellik_degerleri")
}

model StokOzellikDegeri {
  stokKartiId Int @map("urun_id")
  degerId Int @map("deger_id")
  stokKarti StokKarti @relation(fields: [stokKartiId], references: [kimlik], onDelete: Cascade)
  deger OzellikDegeri @relation(fields: [degerId], references: [id], onDelete: Cascade)
  @@id([stokKartiId, degerId])
  @@map("urun_ozellik_degerleri")
}

model StokVaryanti {
  id Int @id @default(autoincrement())
  stokKartiId Int @map("urun_id")
  kod String @db.VarChar(100)
  barkod String? @db.VarChar(100)
  fiyat Decimal @db.Decimal(18, 6)
  miktar Decimal @db.Decimal(18, 6)
  stokKarti StokKarti @relation(fields: [stokKartiId], references: [kimlik], onDelete: Cascade)
  degerler StokVaryantDegeri[]
  @@unique([stokKartiId, kod])
  @@index([stokKartiId])
  @@map("urun_varyantlari")
}

model StokVaryantDegeri {
  varyantId Int @map("varyant_id")
  degerId Int @map("deger_id")
  varyant StokVaryanti @relation(fields: [varyantId], references: [id], onDelete: Cascade)
  deger OzellikDegeri @relation(fields: [degerId], references: [id], onDelete: Restrict)
  @@id([varyantId, degerId])
  @@map("urun_varyant_degerleri")
}

model StokBirimi {
  kimlik                  Int              @id @default(autoincrement()) @map("id")
  stokKartiKimligi        Int              @map("urun_id")
  birimKimligi            Int              @map("birim_id")
  sira                    Int              @map("sira")
  carpan                  Decimal          @map("carpan") @db.Decimal(18, 6)
  anaBirim                Boolean          @map("ana_birim")
  varsayilanBirim         Boolean          @map("varsayilan_birim")
  agirlik                 Decimal?         @map("agirlik") @db.Decimal(18, 6)
  agirlikBirimi           String           @map("agirlik_birimi") @db.VarChar(2)
  hacimDesi               Decimal?         @map("hacim_desi") @db.Decimal(18, 6)
  stokKarti               StokKarti        @relation(fields: [stokKartiKimligi], references: [kimlik], onDelete: Cascade, map: "urun_birimleri_kart_baglantisi")
  secenek                 StokSecenegi     @relation(fields: [birimKimligi], references: [kimlik], map: "urun_birimleri_secenek_baglantisi")
  fiyatlar                StokFiyati[]
  barkodlar               StokBarkodu[]

  @@index([stokKartiKimligi], map: "urun_birimleri_kart_indeks")
  @@map("urun_birimleri")
}

model StokFiyati {
  kimlik            Int            @id @default(autoincrement()) @map("id")
  stokBirimiKimligi Int            @map("urun_birimi_id")
  fiyatListesiKimligi Int          @map("fiyat_listesi_id")
  fiyatYonu         String         @map("fiyat_yonu") @db.VarChar(5)
  girilenFiyat      Decimal?       @map("girilen_fiyat") @db.Decimal(18, 6)
  paraBirimi        String         @map("para_birimi") @db.Char(3)
  iskontoOrani      Decimal?       @map("iskonto_orani") @db.Decimal(18, 6)
  kdvOrani          Decimal?       @map("kdv_orani") @db.Decimal(18, 6)
  kdvDahilGirildi   Boolean        @map("kdv_dahil_girildi")
  stokBirimi        StokBirimi     @relation(fields: [stokBirimiKimligi], references: [kimlik], onDelete: Cascade, map: "urun_fiyatlari_birim_baglantisi")
  fiyatListesi      StokSecenegi   @relation(fields: [fiyatListesiKimligi], references: [kimlik], map: "urun_fiyatlari_liste_baglantisi")

  @@unique([stokBirimiKimligi, fiyatListesiKimligi, fiyatYonu], map: "urun_fiyatlari_birim_liste_yon_tekil")
  @@map("urun_fiyatlari")
}


model StokBarkodu {
  kimlik            Int        @id @default(autoincrement()) @map("id")
  stokBirimiKimligi Int        @map("urun_birimi_id")
  barkodTuru        String     @map("barkod_turu") @db.VarChar(10)
  barkod            String     @map("barkod") @db.VarChar(128)
  stokBirimi        StokBirimi @relation(fields: [stokBirimiKimligi], references: [kimlik], onDelete: Cascade, map: "urun_barkodlari_birim_baglantisi")

  @@unique([stokBirimiKimligi, barkod], map: "urun_barkodlari_birim_kod_tekil")
  @@index([barkod], map: "urun_barkodlari_kod_indeks")
  @@map("urun_barkodlari")
}

model Isletme {
  id Int @id @default(autoincrement())
  name String @map("ad") @db.VarChar(120)
  ownerId Int @unique @map("sahip_id")
  createdAt DateTime @default(now()) @map("olusturma_zamani")
  owner Kullanici @relation("BusinessOwner", fields: [ownerId], references: [kimlik], onDelete: Restrict)
  members IsletmeUyesi[]
  roles IsletmeRolu[]
  settings IsletmeAyari[]
  logs IslemKaydi[]
  @@map("isletmeler")
}

model IsletmeUyesi {
  id Int @id @default(autoincrement())
  businessId Int @map("isletme_id")
  userId Int? @unique @map("kullanici_id")
  email String? @unique @map("eposta") @db.VarChar(254)
  name String @map("ad") @db.VarChar(120)
  roleId Int? @map("rol_id")
  active Boolean @default(true) @map("etkin")
  createdAt DateTime @default(now()) @map("olusturma_zamani")
  business Isletme @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user Kullanici? @relation(fields: [userId], references: [kimlik], onDelete: Restrict)
  role IsletmeRolu? @relation(fields: [roleId], references: [id], onDelete: Restrict)
  @@index([businessId])
  @@map("isletme_uyeleri")
}

model IsletmeRolu {
  id Int @id @default(autoincrement())
  businessId Int @map("isletme_id")
  name String @map("ad") @db.VarChar(120)
  business Isletme @relation(fields: [businessId], references: [id], onDelete: Cascade)
  permissions RolYetkisi[]
  members IsletmeUyesi[]
  @@unique([businessId, name])
  @@map("isletme_rolleri")
}

model RolYetkisi {
  roleId Int @map("rol_id")
  resource String @map("bolum") @db.VarChar(30)
  read Boolean @map("goruntule")
  save Boolean @map("kaydet")
  delete Boolean @map("sil")
  role IsletmeRolu @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([roleId, resource])
  @@map("rol_yetkileri")
}

model IsletmeAyari {
  businessId Int @map("isletme_id")
  section String @map("bolum") @db.VarChar(30)
  key String @map("alan") @db.VarChar(80)
  value String @map("deger") @db.Text
  business Isletme @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@id([businessId, section, key])
  @@map("isletme_ayarlari")
}

model IslemKaydi {
  id Int @id @default(autoincrement())
  businessId Int @map("isletme_id")
  userId Int? @map("kullanici_id")
  userName String @map("kullanici_adi") @db.VarChar(254)
  section String @map("bolum") @db.VarChar(30)
  action String @map("islem") @db.VarChar(80)
  target String? @map("kayit") @db.VarChar(200)
  status String @map("sonuc") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("olusturma_zamani")
  business Isletme @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user Kullanici? @relation(fields: [userId], references: [kimlik], onDelete: SetNull)
  changes IslemDegisikligi[]
  @@index([businessId, createdAt, id])
  @@map("islem_kayitlari")
