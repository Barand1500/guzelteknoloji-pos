// MySQL 8+ / MariaDB 10.6+ için şema.
// Kayıt kimlikleri otomatik artan sayısal değerlerdir.
// Tüm zaman damgaları UTC olarak saklanır.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

enum KullaniciDurumu {
  AKTIF      @map("ACTIVE")
  DEVRE_DISI @map("DISABLED")
}

enum GirisSaglayicisi {
  GOOGLE
  APPLE
}

enum GirisYontemi {
  EPOSTA @map("EMAIL")
  GOOGLE
  APPLE
}

enum KampanyaTuru {
  SEPET_INDIRIMI
  UCRETSIZ_KARGO
}

enum IndirimTuru {
  YUZDE
  TUTAR
}

model Kullanici {
  ownedBusiness Isletme? @relation("BusinessOwner")
  businessMember IsletmeUyesi?
  activityLogs IslemLogu[]

  kimlik                Int             @id @default(autoincrement()) @map("id")
  /// Normalize edilmiş (trim + küçük harf) e-posta. OAuth-only kullanıcılarda da doldurulur.
  eposta                String?         @unique(map: "kullanicilar_eposta_tekil") @map("eposta") @db.VarChar(254)
  epostaDogrulamaTarihi DateTime?       @map("eposta_dogrulama_tarihi")
  gorunenAd             String?         @map("gorunen_ad") @db.VarChar(120)
  profilResmiAdresi     String?         @map("profil_resmi_adresi") @db.VarChar(2048)
  durum                 KullaniciDurumu @default(AKTIF) @map("durum")
  olusturmaTarihi       DateTime        @default(now()) @map("olusturma_tarihi")
  guncellemeTarihi      DateTime        @updatedAt @map("guncelleme_tarihi")

  sonGirisYontemi GirisYontemi? @map("son_giris_yontemi")
  sonGirisTarihi  DateTime?     @map("son_giris_tarihi")

  /// Şifresiz hesaplarda boş; Argon2id PHC hash'i API kullanıcı yanıtlarına alınmaz.
  sifreHash             String?        @map("sifre_hash") @db.VarChar(255)
  sifreOlusturmaTarihi  DateTime?      @map("sifre_olusturma_tarihi")
  sifreGuncellemeTarihi DateTime?      @map("sifre_guncelleme_tarihi")
  girisKimlikleri       GirisKimligi[]
  oturumlar             Oturum[]
  stokSecenekleri       StokSecenegi[]
  stokKartlari          StokKarti[]
  markalar              Marka[]
  kategoriler           Kategori[]
  firsatlar             Firsat[]
  ozellikSablonlari      OzellikSablonu[]
  campaigns              Kampanya[]

  @@map("kullanicilar")
}

model GirisKimligi {
  kimlik                    Int              @id @default(autoincrement()) @map("id")
  kullaniciKimligi          Int              @map("kullanici_id")
  saglayici                 GirisSaglayicisi @map("saglayici")
  /// Sağlayıcının değişmez kullanıcı kimliği (Google için `sub`). E-posta DEĞİL.
  saglayiciKullaniciKimligi String           @map("saglayici_kullanici_id") @db.VarChar(255)
  /// Bilgi amaçlı; eşleştirme için kullanılmaz.
  eposta                    String?          @map("eposta") @db.VarChar(254)
  sonKullanimTarihi         DateTime?        @map("son_kullanim_tarihi")
  olusturmaTarihi           DateTime         @default(now()) @map("olusturma_tarihi")
  guncellemeTarihi          DateTime         @updatedAt @map("guncelleme_tarihi")

  kullanici Kullanici @relation(fields: [kullaniciKimligi], references: [kimlik], onDelete: Cascade, map: "giris_kimlikleri_kullanici_baglantisi")

  @@unique([saglayici, saglayiciKullaniciKimligi], map: "giris_kimlikleri_saglayici_kullanici_tekil")
  @@index([kullaniciKimligi], map: "giris_kimlikleri_kullanici_indeks")
  @@map("giris_kimlikleri")
}

model Oturum {
  kimlik                Int           @id @default(autoincrement()) @map("id")
  kullaniciKimligi      Int           @map("kullanici_id")
  /// Cookie'deki opak token'ın SHA-256 hash'i (hex). Ham token veritabanında tutulmaz.
  girisYontemi          GirisYontemi? @map("giris_yontemi")
  oturumAnahtariHash    String        @unique(map: "oturumlar_anahtar_hash_tekil") @map("oturum_anahtari_hash") @db.Char(64)
  gecerlilikBitisTarihi DateTime      @map("gecerlilik_bitis_tarihi")
  sonGorulmeTarihi      DateTime      @default(now()) @map("son_gorulme_tarihi")
  iptalTarihi           DateTime?     @map("iptal_tarihi")
  ipAdresi              String?       @map("ip_adresi") @db.VarChar(45)
  istemciBilgisi        String?       @map("istemci_bilgisi") @db.VarChar(512)
  olusturmaTarihi       DateTime      @default(now()) @map("olusturma_tarihi")

  kullanici Kullanici @relation(fields: [kullaniciKimligi], references: [kimlik], onDelete: Cascade, map: "oturumlar_kullanici_baglantisi")

  @@index([kullaniciKimligi], map: "oturumlar_kullanici_indeks")
  @@index([gecerlilikBitisTarihi], map: "oturumlar_gecerlilik_indeks")
  @@map("oturumlar")
}

/// E-postaya gönderilen tek kullanımlık giriş kodları. Kullanıcıya bağlı DEĞİLDİR (hesap kod
/// doğrulanınca oluşur). Düz e-posta ve düz kod saklanmaz: ikisi de HMAC hash'tir.
model EpostaGirisKodu {
  kimlik                Int      @id @default(autoincrement()) @map("id")
  /// HMAC-SHA256(gizli anahtar, e-posta) hex.
  epostaHash            String   @map("eposta_hash") @db.Char(64)
  /// HMAC-SHA256(gizli anahtar, "e-posta:kod") hex.
  kodHash               String   @map("kod_hash") @db.Char(64)
  gecerlilikBitisTarihi DateTime @map("gecerlilik_bitis_tarihi")
  /// Yanlış deneme sayısı; sınır aşılınca kod geçersiz olur.
  denemeSayisi          Int      @default(0) @map("deneme_sayisi")
  olusturmaTarihi       DateTime @default(now()) @map("olusturma_tarihi")

  @@index([epostaHash, olusturmaTarihi], map: "eposta_kodlari_eposta_olusturma_indeks")
  @@index([olusturmaTarihi], map: "eposta_kodlari_olusturma_indeks")
  @@map("eposta_giris_kodlari")
}

/// Kullanıcıya ait sabit/özel seçimler. Kullanılmış seçenekler silinmez, pasifleştirilir.
model StokSecenegi {
  kimlik            Int                @id @default(autoincrement()) @map("id")
  kullaniciKimligi  Int                @map("kullanici_id")
  listeTuru         String             @map("liste_turu") @db.VarChar(30)
  secenekKodu       String             @map("secenek_kodu") @db.VarChar(100)
  secenekAdi        String             @map("secenek_adi") @db.VarChar(120)
  adHash            String             @map("ad_hash") @db.Char(64)
  silinebilir       Boolean            @default(false) @map("silinebilir")
  durum             Boolean            @default(true) @map("durum")
  sira              Int                @default(0) @map("sira")
  olusturmaTarihi   DateTime           @default(now()) @map("olusturma_tarihi")
  kullanici         Kullanici          @relation(fields: [kullaniciKimligi], references: [kimlik], onDelete: Cascade, map: "urun_secenekleri_kullanici_baglantisi")
  tipKartlari       StokKarti[]        @relation("StockType")
  urunVergileri UrunVergisi[]
  fiyatlar          StokFiyati[]
  birimler          StokBirimi[]
  fiyatListesiAyari FiyatListesiAyari?

  @@unique([kullaniciKimligi, listeTuru, secenekKodu], map: "urun_secenekleri_kod_tekil")
  @@unique([kullaniciKimligi, listeTuru, adHash], map: "urun_secenekleri_ad_tekil")
  @@map("urun_secenekleri")
}

/// Marka bilgileri tek kayıttadır ve oturumdaki kullanıcıya aittir.
model Marka {
  kimlik           Int         @id @default(autoincrement()) @map("id")
  kullaniciKimligi Int         @map("kullanici_id")
  markaKodu        String      @map("marka_kodu") @db.VarChar(100)
  markaAdi         String      @map("marka_adi") @db.VarChar(120)
  adHash           String      @map("ad_hash") @db.Char(64)
  durum            Boolean     @default(true) @map("durum")
  sira             Int         @default(0) @map("sira")
  olusturmaTarihi  DateTime    @default(now()) @map("olusturma_tarihi")
  aciklama         String      @map("aciklama") @db.Text
  logoVerisi       Bytes?      @map("logo_verisi") @db.MediumBlob
  logoDosyasi      String?     @map("logo_dosyasi") @db.VarChar(255)
  logoHash         String?     @map("logo_hash") @db.Char(64)
  seoBasligi       String      @map("seo_basligi") @db.VarChar(250)
  seoAciklamasi    String      @map("seo_aciklamasi") @db.VarChar(1000)
  guncellemeTarihi DateTime    @updatedAt @map("guncelleme_tarihi")
  kullanici        Kullanici   @relation(fields: [kullaniciKimligi], references: [kimlik], onDelete: Cascade, map: "markalar_kullanici_baglantisi")
  stokKartlari     StokKarti[]
  kampanyaKurallari KampanyaKuralMarkasi[]

  @@unique([kullaniciKimligi, markaKodu], map: "markalar_kod_tekil")
  @@unique([kullaniciKimligi, adHash], map: "markalar_ad_tekil")
  @@map("markalar")
}

model StokKarti {
  kimlik               Int                @id @default(autoincrement()) @map("id")
  kullaniciKimligi     Int                @map("kullanici_id")
  kayitIstegiKimligi   String             @map("kayit_istegi_id") @db.Char(36)
  kayitIstegiHash      String             @map("kayit_istegi_hash") @db.Char(64)
  stokKodu             String?            @map("urun_kodu") @db.VarChar(100)
  stokAdi              String?            @map("urun_adi") @db.VarChar(250)
  stokTipiKimligi      Int                @map("urun_tipi_id")
  markaKimligi         Int?               @map("marka_id")
  satisAcik            Boolean            @default(true) @map("satisa_acik")
  stokMiktari          Decimal            @default(0) @map("stok_miktari") @db.Decimal(18, 6)
  envanterTakibi       String             @map("envanter_takibi") @db.VarChar(10)
  altLimit             Decimal?           @map("alt_limit") @db.Decimal(18, 6)
  ustLimit             Decimal?           @map("ust_limit") @db.Decimal(18, 6)
  mensei               String?            @map("mensei") @db.VarChar(40)
  seoBasligi           String             @default("") @map("seo_basligi") @db.VarChar(250)
  seoAciklamasi        String             @default("") @map("seo_aciklamasi") @db.VarChar(1000)
  olusturmaTarihi      DateTime           @default(now()) @map("olusturma_tarihi")
  guncellemeTarihi     DateTime           @updatedAt @map("guncelleme_tarihi")
  kullanici            Kullanici          @relation(fields: [kullaniciKimligi], references: [kimlik], onDelete: Cascade, map: "urunler_kullanici_baglantisi")
  stokTipi             StokSecenegi       @relation("StockType", fields: [stokTipiKimligi], references: [kimlik], map: "urunler_tip_baglantisi")
  marka                Marka?             @relation(fields: [markaKimligi], references: [kimlik], map: "urunler_marka_baglantisi")
  vergiler             UrunVergisi[]
  birimler             StokBirimi[]
  kategoriler          StokKartiKategori[]
  firsatlar            StokFirsati[]
  gorseller            StokGorseli[]
  ozellikDegerleri     StokOzellikDegeri[]
  varyantlar           StokVaryanti[]

  @@unique([kullaniciKimligi, stokKodu], map: "urunler_kullanici_kod_tekil")
  @@unique([kullaniciKimligi, kayitIstegiKimligi], map: "urunler_kayit_istegi_tekil")
  @@map("urunler")
}

/// Dosya uploads/urunler içinde özgün biçimde tutulur; ilk sıra vitrin görselidir.
model StokGorseli {
  id          Int       @id @default(autoincrement())
  stokKartiId Int       @map("urun_id")
  dosyaAdi    String    @unique @map("dosya_adi") @db.VarChar(255)
  sira        Int       @default(0)
  stokKarti   StokKarti @relation(fields: [stokKartiId], references: [kimlik], onDelete: Cascade)

  @@index([stokKartiId, sira])
  @@map("urun_gorselleri")
}

model Kategori {
  id              Int                     @id @default(autoincrement())
  kullaniciId     Int                     @map("kullanici_id")
  ustId           Int?                    @map("ust_kategori_id")
  ad              String                  @db.VarChar(120)
  aciklama        String                  @db.Text
  gorselDosyasi   String?                 @map("gorsel_dosyasi") @db.VarChar(255)
  durum           Boolean                 @default(true) @map("durum")
  gizli           Boolean                 @default(false)
  seoBasligi      String                  @map("seo_basligi") @db.VarChar(250)
  seoAciklamasi   String                  @map("seo_aciklamasi") @db.VarChar(1000)
  sira            Int                     @default(0)
  kullanici       Kullanici               @relation(fields: [kullaniciId], references: [kimlik], onDelete: Cascade)
  ust             Kategori?               @relation("KategoriAgaci", fields: [ustId], references: [id], onDelete: Restrict)
  altlar          Kategori[]              @relation("KategoriAgaci")
  stokKartlari    StokKartiKategori[]
  ozellikSablonlari OzellikSablonKategori[]
  kampanyaKurallari KampanyaKuralKategorisi[]
  @@index([kullaniciId, ustId])
  @@map("kategoriler")
}

model StokKartiKategori {
  stokKartiId Int @map("urun_id")
  kategoriId Int @map("kategori_id")
  stokKarti StokKarti @relation(fields: [stokKartiId], references: [kimlik], onDelete: Cascade)
  kategori Kategori @relation(fields: [kategoriId], references: [id], onDelete: Cascade)
  @@id([stokKartiId, kategoriId])
  @@map("urun_kategorileri")
}

model Firsat {
  id Int @id @default(autoincrement())
  kullaniciId Int @map("kullanici_id")
  ad String @db.VarChar(120)
  ikonDosyasi String? @map("ikon_dosyasi") @db.VarChar(255)
  durum Boolean @default(true) @map("durum")
  resimdeGoster Boolean @map("resimde_goster")
  konum String @db.VarChar(10)
  boyut String @db.VarChar(10)
  seoBasligi String @map("seo_basligi") @db.VarChar(250)
  seoAciklamasi String @map("seo_aciklamasi") @db.VarChar(1000)
  sira Int @default(0)
  kullanici Kullanici @relation(fields: [kullaniciId], references: [kimlik], onDelete: Cascade)
  stokKartlari StokFirsati[]
  @@index([kullaniciId, sira])
  @@map("firsatlar")
}

model StokFirsati {
  stokKartiId Int @map("urun_id")
  firsatId Int @map("firsat_id")
  stokKarti StokKarti @relation(fields: [stokKartiId], references: [kimlik], onDelete: Cascade)
  firsat Firsat @relation(fields: [firsatId], references: [id], onDelete: Cascade)
  @@id([stokKartiId, firsatId])
  @@map("urun_firsatlari")
}

/// İki kampanya ekranının genel kuralı; işletme sahibine ve kampanya türüne göre tektir.
model Kampanya {
  id                 Int          @id @default(autoincrement())
  userId             Int          @map("kullanici_id")
  kind               KampanyaTuru @map("tur")
  durum              Boolean      @default(false) @map("durum")
  customerTypes      Json         @map("cari_tipleri")
  priceLists         Json         @map("fiyat_listeleri")
  minTotal           Decimal      @default(0) @map("minimum_sepet") @db.Decimal(18, 2)
  discountKind       IndirimTuru? @map("indirim_turu")
  discountValue      Decimal?     @map("indirim_degeri") @db.Decimal(18, 2)
  olusturmaTarihi    DateTime     @default(now()) @map("olusturma_tarihi")
  guncellemeTarihi   DateTime     @updatedAt @map("guncelleme_tarihi")
  user               Kullanici    @relation(fields: [userId], references: [kimlik], onDelete: Cascade)
  rules              KampanyaKural[]

  @@unique([userId, kind], map: "kampanyalar_kullanici_tur_tekil")
  @@map("kampanyalar")
}

/// Belirli kategori/marka ve müşteri kapsamına uygulanacak özel kampanya kuralı.
model KampanyaKural {
  id              Int                       @id @default(autoincrement())
  campaignId      Int                       @map("kampanya_id")
  durum           Boolean                   @default(true) @map("durum")
  customerTypes   Json                      @map("cari_tipleri")
  priceLists      Json                      @map("fiyat_listeleri")
  minTotal        Decimal                   @default(0) @map("minimum_sepet") @db.Decimal(18, 2)
  discountKind    IndirimTuru?              @map("indirim_turu")
  discountValue   Decimal?                  @map("indirim_degeri") @db.Decimal(18, 2)
  olusturmaTarihi DateTime                  @default(now()) @map("olusturma_tarihi")
  guncellemeTarihi DateTime                 @updatedAt @map("guncelleme_tarihi")
  campaign        Kampanya                  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  categoryLinks   KampanyaKuralKategorisi[]
  brandLinks      KampanyaKuralMarkasi[]

  @@index([campaignId, id], map: "kampanya_kurallari_kampanya_indeks")
  @@map("kampanya_kurallari")
}

model KampanyaKuralKategorisi {
  ruleId     Int           @map("kural_id")
  categoryId Int           @map("kategori_id")
  rule       KampanyaKural @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  category   Kategori      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([ruleId, categoryId])
  @@index([categoryId], map: "kampanya_kural_kategorileri_kategori_indeks")
  @@map("kampanya_kural_kategorileri")
}

model KampanyaKuralMarkasi {
  ruleId  Int           @map("kural_id")
  brandId Int           @map("marka_id")
  rule    KampanyaKural @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  brand   Marka         @relation(fields: [brandId], references: [kimlik], onDelete: Cascade)

  @@id([ruleId, brandId])
  @@index([brandId], map: "kampanya_kural_markalari_marka_indeks")
  @@map("kampanya_kural_markalari")
}

model OzellikSablonu {
  id Int @id @default(autoincrement())
  kullaniciId Int @map("kullanici_id")
  ad String @db.VarChar(120)
  tumUrunler Boolean @default(false) @map("tum_urunler")
  sira Int @default(0)
  kullanici Kullanici @relation(fields: [kullaniciId], references: [kimlik], onDelete: Cascade)
  kategoriler OzellikSablonKategori[]
  gruplar OzellikGrubu[]
  @@index([kullaniciId, sira])
  @@map("ozellik_sablonlari")
}

model OzellikSablonKategori {
  sablonId Int @map("sablon_id")
  kategoriId Int @map("kategori_id")
  sablon OzellikSablonu @relation(fields: [sablonId], references: [id], onDelete: Cascade)
  kategori Kategori @relation(fields: [kategoriId], references: [id], onDelete: Cascade)
  @@id([sablonId, kategoriId])
  @@map("ozellik_sablon_kategorileri")
}

model OzellikGrubu {
  id Int @id @default(autoincrement())
  sablonId Int @map("sablon_id")
  ad String @db.VarChar(120)
  tur String @db.VarChar(10)
  filtre Boolean @default(false)
  coklu Boolean @default(false)
  varyant Boolean @default(false)
  resimdeGoster Boolean @default(false) @map("resimde_goster")
  konum String @db.VarChar(10)
  boyut String @db.VarChar(10)
  sira Int @default(0)
  sablon OzellikSablonu @relation(fields: [sablonId], references: [id], onDelete: Cascade)
  degerler OzellikDegeri[]
  @@index([sablonId, sira])
  @@map("ozellik_gruplari")
}

model OzellikDegeri {
  id Int @id @default(autoincrement())
  grupId Int @map("grup_id")
  kod String @db.VarChar(120)
  ad String @db.VarChar(120)
  renk String? @db.VarChar(7)
  gorselDosyasi String? @map("gorsel_dosyasi") @db.VarChar(255)
  sira Int @default(0)
  grup OzellikGrubu @relation(fields: [grupId], references: [id], onDelete: Cascade)
  stokKartlari StokOzellikDegeri[]
  varyantlar StokVaryantDegeri[]
  @@unique([grupId, kod])
  @@index([grupId, sira])
  @@map("ozellik_degerleri")
}

model StokOzellikDegeri {
  stokKartiId Int @map("urun_id")
  degerId Int @map("deger_id")
  stokKarti StokKarti @relation(fields: [stokKartiId], references: [kimlik], onDelete: Cascade)
  deger OzellikDegeri @relation(fields: [degerId], references: [id], onDelete: Cascade)
  @@id([stokKartiId, degerId])
  @@map("urun_ozellik_degerleri")
}

model StokVaryanti {
  id Int @id @default(autoincrement())
  stokKartiId Int @map("urun_id")
  kod String @db.VarChar(100)
  barkod String? @db.VarChar(100)
  fiyat Decimal @db.Decimal(18, 6)
  miktar Decimal @db.Decimal(18, 6)
  stokKarti StokKarti @relation(fields: [stokKartiId], references: [kimlik], onDelete: Cascade)
  degerler StokVaryantDegeri[]
  @@unique([stokKartiId, kod])
  @@index([stokKartiId])
  @@map("urun_varyantlari")
}

model StokVaryantDegeri {
  varyantId Int @map("varyant_id")
  degerId Int @map("deger_id")
  varyant StokVaryanti @relation(fields: [varyantId], references: [id], onDelete: Cascade)
  deger OzellikDegeri @relation(fields: [degerId], references: [id], onDelete: Restrict)
  @@id([varyantId, degerId])
  @@map("urun_varyant_degerleri")
}

model StokBirimi {
  kimlik                  Int              @id @default(autoincrement()) @map("id")
  stokKartiKimligi        Int              @map("urun_id")
  birimKimligi            Int              @map("birim_id")
  sira                    Int              @map("sira")
  carpan                  Decimal          @map("carpan") @db.Decimal(18, 6)
  anaBirim                Boolean          @map("ana_birim")
  varsayilanBirim         Boolean          @map("varsayilan_birim")
  agirlik                 Decimal?         @map("agirlik") @db.Decimal(18, 6)
  agirlikBirimi           String           @map("agirlik_birimi") @db.VarChar(2)
  hacimDesi               Decimal?         @map("hacim_desi") @db.Decimal(18, 6)
  stokKarti               StokKarti        @relation(fields: [stokKartiKimligi], references: [kimlik], onDelete: Cascade, map: "urun_birimleri_kart_baglantisi")
  secenek                 StokSecenegi     @relation(fields: [birimKimligi], references: [kimlik], map: "urun_birimleri_secenek_baglantisi")
  fiyatlar                StokFiyati[]
  barkodlar               StokBarkodu[]

  @@index([stokKartiKimligi], map: "urun_birimleri_kart_indeks")
  @@map("urun_birimleri")
}

model StokFiyati {
  kimlik            Int            @id @default(autoincrement()) @map("id")
  stokBirimiKimligi Int            @map("urun_birimi_id")
  fiyatListesiKimligi Int          @map("fiyat_listesi_id")
  fiyatYonu         String         @map("fiyat_yonu") @db.VarChar(5)
  girilenFiyat      Decimal?       @map("girilen_fiyat") @db.Decimal(18, 6)
  paraBirimi        String         @map("para_birimi") @db.Char(3)
  iskontoOrani      Decimal?       @map("iskonto_orani") @db.Decimal(18, 6)
  kdvOrani          Decimal?       @map("kdv_orani") @db.Decimal(18, 6)
  kdvDahilGirildi   Boolean        @map("kdv_dahil_girildi")
  stokBirimi        StokBirimi     @relation(fields: [stokBirimiKimligi], references: [kimlik], onDelete: Cascade, map: "urun_fiyatlari_birim_baglantisi")
  fiyatListesi      StokSecenegi   @relation(fields: [fiyatListesiKimligi], references: [kimlik], map: "urun_fiyatlari_liste_baglantisi")

  @@unique([stokBirimiKimligi, fiyatListesiKimligi, fiyatYonu], map: "urun_fiyatlari_birim_liste_yon_tekil")
  @@map("urun_fiyatlari")
}


model StokBarkodu {
  kimlik            Int        @id @default(autoincrement()) @map("id")
  stokBirimiKimligi Int        @map("urun_birimi_id")
  barkodTuru        String     @map("barkod_turu") @db.VarChar(10)
  barkod            String     @map("barkod") @db.VarChar(128)
  stokBirimi        StokBirimi @relation(fields: [stokBirimiKimligi], references: [kimlik], onDelete: Cascade, map: "urun_barkodlari_birim_baglantisi")

  @@unique([stokBirimiKimligi, barkod], map: "urun_barkodlari_birim_kod_tekil")
  @@index([barkod], map: "urun_barkodlari_kod_indeks")
  @@map("urun_barkodlari")
}

model Isletme {
  id Int @id @default(autoincrement())
  name String @map("ad") @db.VarChar(120)
  ownerId Int @unique @map("sahip_id")
  olusturmaTarihi DateTime @default(now()) @map("olusturma_tarihi")
  owner Kullanici @relation("BusinessOwner", fields: [ownerId], references: [kimlik], onDelete: Restrict)
  members IsletmeUyesi[]
  roles IsletmeRolu[]
  settings IsletmeAyari[]
  logs IslemLogu[]
  orders Siparis[]
  returns IadeTalebi[]
  musteriler Musteri[]
  paraBirimleri ParaBirimi[]
  kargoFirmalari KargoFirmasi[]
  kargoLokasyonlari KargoLokasyonu[]
  kargoTanimlari KargoTanimi[]
  vergiTurleri VergiTuru[]
  vergiDaireleri VergiDairesi[]
  cariTipleri CariTipi[]
  fiyatListesiAyarlari FiyatListesiAyari[]
  bildirimler Bildirim[]
  siteSayfalari SiteSayfasi[]
  siteMenuOgeleri SiteMenuOgesi[]
  siteGorselleri SiteGorseli[]
  siteSliderlari SiteSlideri[]
  siteWidgetlari SiteWidgeti[]
  siteSablonDegiskenleri SiteSablonDegiskeni[]
  seoYonlendirmeleri SeoYonlendirmesi[]
  odemeSekilleri OdemeSekli[]
  ozelTatiller OzelTatil[]
  sablonGonderimleri SablonGonderimi[]
  @@map("isletmeler")
}

model IsletmeUyesi {
  id Int @id @default(autoincrement())
  businessId Int @map("isletme_id")
  userId Int? @unique @map("kullanici_id")
  email String? @unique @map("eposta") @db.VarChar(254)
  name String @map("ad") @db.VarChar(120)
  roleId Int? @map("rol_id")
  durum Boolean @default(true) @map("durum")
  olusturmaTarihi DateTime @default(now()) @map("olusturma_tarihi")
  business Isletme @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user Kullanici? @relation(fields: [userId], references: [kimlik], onDelete: Restrict)
  role IsletmeRolu? @relation(fields: [roleId], references: [id], onDelete: Restrict)
  @@index([businessId])
  @@map("isletme_uyeleri")
}

model IsletmeRolu {
  id Int @id @default(autoincrement())
  businessId Int @map("isletme_id")
  name String @map("ad") @db.VarChar(120)
  business Isletme @relation(fields: [businessId], references: [id], onDelete: Cascade)
  permissions RolYetkisi[]
  members IsletmeUyesi[]
  @@unique([businessId, name])
  @@map("isletme_rolleri")
}

model RolYetkisi {
  roleId Int @map("rol_id")
  resource String @map("bolum") @db.VarChar(30)
  read Boolean @map("goruntule")
  save Boolean @map("kaydet")
  delete Boolean @map("sil")
  role IsletmeRolu @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([roleId, resource])
  @@map("rol_yetkileri")
}

model SablonGonderimi {
  id Int @id @default(autoincrement())
  isletmeId Int @map("isletme_id")
  olayAnahtari String @map("olay_anahtari") @db.VarChar(100)
  olay String @db.VarChar(40)
  kanal String @db.VarChar(10)
  alici String @db.VarChar(254)
  konu String @db.VarChar(500)
  icerik String @db.MediumText
  durum String @default("pending") @db.VarChar(20)
  hataKodu String? @map("hata_kodu") @db.VarChar(80)
  olusturmaTarihi DateTime @default(now()) @map("olusturma_tarihi")
  guncellemeTarihi DateTime @updatedAt @map("guncelleme_tarihi")
  gonderimTarihi DateTime? @map("gonderim_tarihi")
  isletme Isletme @relation(fields: [isletmeId], references: [id], onDelete: Cascade, map: "sablon_gonderimleri_isletme_baglantisi")
  @@unique([isletmeId, olayAnahtari, kanal], map: "sablon_gonderimleri_olay_tekil")
  @@index([durum, id], map: "sablon_gonderimleri_kuyruk_indeks")
  @@map("sablon_gonderimleri")
}

model IsletmeAyari {
  businessId Int @map("isletme_id")
  section String @map("bolum") @db.VarChar(30)
  values Json @map("degerler")
  business Isletme @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@id([businessId, section])
  @@map("isletme_ayarlari")
}

model IslemLogu {
  id Int @id @default(autoincrement())
  businessId Int @map("isletme_id")
  userId Int? @map("kullanici_id")
  userName String @map("kullanici_adi") @db.VarChar(254)
  section String @map("bolum") @db.VarChar(30)
  action String @map("islem") @db.VarChar(80)
  target String? @map("kayit") @db.VarChar(200)
  status String @map("sonuc") @db.VarChar(20)
  olusturmaTarihi DateTime @default(now()) @map("olusturma_tarihi")
  business Isletme @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user Kullanici? @relation(fields: [userId], references: [kimlik], onDelete: SetNull)
  changes IslemKaydiDetayi[]
  @@index([businessId, olusturmaTarihi, id])
  @@map("islem_loglari")
}

/// SEO Ayarları ekranındaki 301 yönlendirme satırı; hedef sayfa tur + kaynak kimliğiyle seçilir.
/// Kaynak kimliği türe göre farklı tabloya baktığından yabancı anahtar DEĞİLDİR; yazarken doğrulanır.
model SeoYonlendirmesi {
  id              Int      @id @default(autoincrement())
  businessId      Int      @map("isletme_id")
  tur             String   @db.VarChar(20)
  kaynakId        Int?     @map("kaynak_id")
  eskiAdres       String   @map("eski_adres") @db.VarChar(300)
  seoBasligi      String   @default("") @map("seo_basligi") @db.VarChar(250)
  seoAciklamasi   String   @default("") @map("seo_aciklamasi") @db.VarChar(1000)
  olusturmaTarihi DateTime @default(now()) @map("olusturma_tarihi")
  business        Isletme  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, tur, eskiAdres], map: "seo_yonlendirmeleri_adres_tekil")
  @@index([businessId, tur, kaynakId], map: "seo_yonlendirmeleri_hedef_indeks")
  @@map("seo_yonlendirmeleri")
}

/// İşlem logunun alan bazındaki eski/yeni değer kaydı; log silinince kendisi de silinir.
model IslemKaydiDetayi {
  id Int @id @default(autoincrement())
  logId Int @map("kayit_id")
  field String @map("alan") @db.VarChar(150)
  before String? @map("eski_deger") @db.Text
  after String? @map("yeni_deger") @db.Text
  log IslemLogu @relation(fields: [logId], references: [id], onDelete: Cascade)
  @@index([logId])
  @@map("islem_kayitlari_detayi")
}

model UrunVergisi {
  urunId Int @map("urun_id")
  vergiId Int @map("vergi_id")
  oran Decimal? @db.Decimal(18, 6)
  sira Int
  urun StokKarti @relation(fields: [urunId], references: [kimlik], onDelete: Cascade)
  vergi StokSecenegi @relation(fields: [vergiId], references: [kimlik], onDelete: Restrict)
  @@id([urunId, vergiId])
  @@map("urun_vergileri")
}

/// İşletmenin siparişi. Satırlar sipariş anındaki ürün adı/kodu/fiyatını taşır; ürün silinse de
/// sipariş bozulmaz. Tutarlar TL'dir; `toplam` KDV hariç, `kdvDahilToplam` KDV dahildir.
model Siparis {
  id               Int             @id @default(autoincrement())
  businessId       Int             @map("isletme_id")
  siparisNo        String          @map("siparis_no") @db.VarChar(40)
  tarih            DateTime        @map("tarih")
  kaynak           String          @map("kaynak") @db.VarChar(20)
  musteriAdi       String          @map("musteri_adi") @db.VarChar(160)
  toplam           Decimal         @map("toplam") @db.Decimal(18, 2)
  kdvDahilToplam   Decimal         @map("kdv_dahil_toplam") @db.Decimal(18, 2)
  odendi           Boolean         @default(false) @map("odendi")
  odemeYontemi     String          @map("odeme_yontemi") @db.VarChar(40)
  durum            String          @default("pending") @map("durum") @db.VarChar(20)
  adres            String          @map("adres") @db.VarChar(500)
  olusturmaTarihi  DateTime        @default(now()) @map("olusturma_tarihi")
  guncellemeTarihi DateTime        @updatedAt @map("guncelleme_tarihi")
  business         Isletme         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  satirlar         SiparisSatiri[]
  akisSurumu       Int             @default(0) @map("akis_surumu")
  istekId          String?         @map("istek_id") @db.Char(36)
  istekHash        String?         @map("istek_hash") @db.Char(64)
  odemeTuru        String?         @map("odeme_turu") @db.VarChar(30)
  indirimTutari    Decimal         @default(0) @map("indirim_tutari") @db.Decimal(18, 2)
  kargoTutari      Decimal         @default(0) @map("kargo_tutari") @db.Decimal(18, 2)
  kargoKdvOrani    Int             @default(20) @map("kargo_kdv_orani")
  hareketler       SiparisOdemeHareketi[]
  iadeler          IadeTalebi[]
  musteriId        Int?            @map("musteri_id")
  musteri          Musteri?        @relation(fields: [musteriId], references: [id], onDelete: SetNull)

  @@unique([businessId, siparisNo], map: "siparisler_isletme_no_tekil")
  @@unique([businessId, istekId], map: "siparisler_isletme_istek_tekil")
  @@index([businessId, tarih], map: "siparisler_isletme_tarih_indeks")
  @@index([musteriId], map: "siparisler_musteri_indeks")
  @@map("siparisler")
}

model SiparisSatiri {
  id           Int      @id @default(autoincrement())
  siparisId    Int      @map("siparis_id")
  /// Sipariş anındaki ürün kimliği; ürün silinirse boş kalır.
  urunId       Int?     @map("urun_id")
  ad           String   @map("ad") @db.VarChar(250)
  kod          String   @map("kod") @db.VarChar(100)
  adet         Decimal  @map("adet") @db.Decimal(18, 3)
  birimFiyat   Decimal  @map("birim_fiyat") @db.Decimal(18, 2)
  /// Satış anındaki birim maliyet; kâr hesabı için. Bilinmiyorsa boş.
  birimMaliyet Decimal? @map("birim_maliyet") @db.Decimal(18, 2)
  sira         Int      @default(0) @map("sira")
  siparis      Siparis  @relation(fields: [siparisId], references: [id], onDelete: Cascade)
  satisTutari  Decimal? @map("satis_tutari") @db.Decimal(18, 2)
  netTutar     Decimal? @map("net_tutar") @db.Decimal(18, 2)
  stokIslendi  Boolean  @default(false) @map("stok_islendi")
  iadeler      IadeSatiri[]

  @@index([siparisId], map: "siparis_satirlari_siparis_indeks")
  @@map("siparis_satirlari")
}

/// İade/değişim talebi. Siparişe yabancı anahtar yerine sipariş numarasıyla bağlanır; sipariş
/// silinse bile talep geçmişi korunur.
model IadeTalebi {
  id               Int      @id @default(autoincrement())
  businessId       Int      @map("isletme_id")
  musteriAdi       String   @map("musteri_adi") @db.VarChar(160)
  siparisNo        String   @map("siparis_no") @db.VarChar(40)
  tur              String   @map("tur") @db.VarChar(20)
  urunAdedi        Int      @map("urun_adedi")
  tarih            DateTime @map("tarih")
  durum            String   @default("pending") @map("durum") @db.VarChar(20)
  sebep            String   @map("sebep") @db.VarChar(500)
  olusturmaTarihi  DateTime @default(now()) @map("olusturma_tarihi")
  guncellemeTarihi DateTime @updatedAt @map("guncelleme_tarihi")
  business         Isletme  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  musteriId        Int?     @map("musteri_id")
  musteri          Musteri? @relation(fields: [musteriId], references: [id], onDelete: SetNull)
  siparisId        Int?     @map("siparis_id")
  siparis          Siparis? @relation(fields: [siparisId], references: [id], onDelete: Restrict)
  istekId          String?  @map("istek_id") @db.Char(36)
  istekHash        String?  @map("istek_hash") @db.Char(64)
  iadeTutari       Decimal? @map("iade_tutari") @db.Decimal(18, 2)
  tamamlamaHash    String? @map("tamamlama_hash") @db.Char(64)
  tamamlamaReferansi String? @map("tamamlama_referansi") @db.VarChar(160)
  tamamlayanId     Int? @map("tamamlayan_id")
  tamamlanmaTarihi DateTime? @map("tamamlanma_tarihi")
  satirlar         IadeSatiri[]
  hareket          SiparisOdemeHareketi?

  @@unique([businessId, istekId], map: "iadeler_isletme_istek_tekil")
  @@index([businessId, tarih], map: "iade_talepleri_isletme_tarih_indeks")
  @@index([musteriId], map: "iade_talepleri_musteri_indeks")
  @@map("iade_talepleri")
}

model IadeSatiri {
  id              Int @id @default(autoincrement())
  iadeId          Int @map("iade_id")
  siparisSatiriId Int @map("siparis_satiri_id")
  adet            Decimal @db.Decimal(18, 3)
  tutar           Decimal @db.Decimal(18, 2)
  stogaEklendi    Boolean @default(false) @map("stoga_eklendi")
  iade            IadeTalebi @relation(fields: [iadeId], references: [id], onDelete: Cascade)
  siparisSatiri   SiparisSatiri @relation(fields: [siparisSatiriId], references: [id], onDelete: Restrict)
  @@unique([iadeId, siparisSatiriId], map: "iade_satirlari_satir_tekil")
  @@index([siparisSatiriId], map: "iade_satirlari_siparis_indeks")
  @@map("iade_satirlari")
}

model SiparisOdemeHareketi {
  id              Int @id @default(autoincrement())
  siparisId       Int @map("siparis_id")
  iadeId          Int? @unique(map: "siparis_odeme_iade_tekil") @map("iade_id")
  istekId         String @map("istek_id") @db.Char(36)
  istekHash       String @map("istek_hash") @db.Char(64)
  tur             String @db.VarChar(20)
  tutar           Decimal @db.Decimal(18, 2)
  referans        String @db.VarChar(160)
  kullaniciId     Int @map("kullanici_id")
  tarih           DateTime @default(now())
  siparis         Siparis @relation(fields: [siparisId], references: [id], onDelete: Restrict)
  iade            IadeTalebi? @relation(fields: [iadeId], references: [id], onDelete: Restrict)
  @@unique([siparisId, istekId], map: "siparis_odeme_istek_tekil")
  @@index([siparisId, tarih], map: "siparis_odeme_tarih_indeks")
  @@map("siparis_odeme_hareketleri")
}

/// İşletmenin müşterisi. Liste ve detay sekmeleri bu kayda bağlıdır; adres, giriş hesabı ve cari
/// hareketler ayrı tablolarda tutulur.
model Musteri {
  id               Int                 @id @default(autoincrement())
  businessId       Int                 @map("isletme_id")
  musteriKodu      String              @default("") @map("musteri_kodu") @db.VarChar(40)
  ad               String              @db.VarChar(160)
  tur              String              @default("real") @db.VarChar(20)
  vergiKimligi     String              @default("") @map("vergi_kimligi") @db.VarChar(20)
  telefon          String              @db.VarChar(30)
  eposta           String              @db.VarChar(254)
  fiyatListesi     String              @map("fiyat_listesi") @db.VarChar(40)
  cariTipi         String              @map("cari_tipi") @db.VarChar(40)
  odemeSekilleri   String              @map("odeme_sekilleri") @db.Text
  kartAnlasmasi    String              @default("") @map("kart_anlasmasi") @db.VarChar(80)
  durum            Boolean             @default(true) @map("durum")
  olusturmaTarihi  DateTime            @default(now()) @map("olusturma_tarihi")
  guncellemeTarihi DateTime            @updatedAt @map("guncelleme_tarihi")
  business         Isletme             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kullanicilar     MusteriKullanicisi[]
  adresler         MusteriAdresi[]
  hareketler       MusteriHareketi[]
  siparisler       Siparis[]
  iadeTalepleri    IadeTalebi[]
  bildirimAlicilari BildirimMusterisi[]

  @@index([businessId, ad], map: "musteriler_isletme_ad_indeks")
  @@map("musteriler")
}

model MusteriKullanicisi {
  id              Int       @id @default(autoincrement())
  musteriId       Int       @map("musteri_id")
  ad              String    @db.VarChar(160)
  eposta          String    @db.VarChar(254)
  durum           Boolean   @default(true) @map("durum")
  sonGiris        DateTime? @map("son_giris")
  olusturmaTarihi DateTime  @default(now()) @map("olusturma_tarihi")
  musteri         Musteri   @relation(fields: [musteriId], references: [id], onDelete: Cascade)

  @@index([musteriId], map: "musteri_kullanicilari_musteri_indeks")
  @@map("musteri_kullanicilari")
}

model MusteriAdresi {
  id               Int      @id @default(autoincrement())
  musteriId        Int      @map("musteri_id")
  baslik           String   @db.VarChar(60)
  adres            String   @db.VarChar(300)
  varsayilan       Boolean  @default(false)
  olusturmaTarihi  DateTime @default(now()) @map("olusturma_tarihi")
  guncellemeTarihi DateTime @updatedAt @map("guncelleme_tarihi")
  musteri          Musteri  @relation(fields: [musteriId], references: [id], onDelete: Cascade)

  @@index([musteriId], map: "musteri_adresleri_musteri_indeks")
  @@map("musteri_adresleri")
}

model MusteriHareketi {
  id              Int      @id @default(autoincrement())
  musteriId       Int      @map("musteri_id")
  tarih           DateTime @map("tarih")
  referans        String   @default("") @db.VarChar(100)
  borc            Decimal  @default(0) @db.Decimal(18, 2)
  alacak          Decimal  @default(0) @db.Decimal(18, 2)
  olusturmaTarihi DateTime @default(now()) @map("olusturma_tarihi")
  musteri         Musteri  @relation(fields: [musteriId], references: [id], onDelete: Cascade)

  @@index([musteriId, tarih], map: "musteri_hareketleri_musteri_tarih_indeks")
  @@map("musteri_hareketleri")
}

// ── Tanımlamalar › Para Birimleri ve Kargo ──────────────────────────────────
model ParaBirimi {
  id        Int      @id @default(autoincrement())
  isletmeId Int      @map("isletme_id")
  ad        String   @db.VarChar(60)
  kisaAd    String   @map("kisa_ad") @db.VarChar(5)
  sembol    String   @db.VarChar(8)
  anaMi     Boolean  @default(false) @map("ana_mi")
  kurTipi   String   @map("kur_tipi") @db.VarChar(20)
  otomatik  Boolean  @default(false)
  kur       Decimal  @default(1) @db.Decimal(18, 6)
  apiUrl    String   @default("") @map("api_url") @db.VarChar(300)
  aktif     Boolean  @default(true)
  sira      Int      @default(0)
  olusturmaTarihi  DateTime @default(now()) @map("olusturma_tarihi")
  guncellemeTarihi DateTime @updatedAt @map("guncelleme_tarihi")
  isletme   Isletme  @relation(fields: [isletmeId], references: [id], onDelete: Cascade)

  @@unique([isletmeId, kisaAd], map: "para_birimleri_kod_tekil")
  @@index([isletmeId, sira], map: "para_birimleri_isletme_sira_indeks")
  @@map("para_birimleri")
}

model KargoFirmasi {
  id        Int      @id @default(autoincrement())
  isletmeId Int      @map("isletme_id")
  ad        String   @db.VarChar(120)
  kisaAd    String   @map("kisa_ad") @db.VarChar(12)
  apiUrl    String   @default("") @map("api_url") @db.VarChar(300)
  kdvOrani  Int      @default(20) @map("kdv_orani")
  sira      Int      @default(0)
  olusturmaTarihi  DateTime @default(now()) @map("olusturma_tarihi")
  guncellemeTarihi DateTime @updatedAt @map("guncelleme_tarihi")
  isletme   Isletme  @relation(fields: [isletmeId], references: [id], onDelete: Cascade)
  fiyatlar  KargoFiyatBasamagi[]

  @@unique([isletmeId, ad], map: "kargo_firmalari_ad_tekil")
  @@index([isletmeId, sira], map: "kargo_firmalari_isletme_sira_indeks")
  @@map("kargo_firmalari")
}

model KargoFiyatBasamagi {
