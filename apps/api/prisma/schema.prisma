/// Fiyat listesi ek bilgileri; liste adı mevcut `urun_secenekleri` (liste_turu = priceLists) satırıdır.
model FiyatListesiAyari {
  id         Int      @id @default(autoincrement())
  isletmeId  Int      @map("isletme_id")
  secenekId  Int      @unique @map("secenek_id")
  tur        String   @default("general") @db.VarChar(10)
  baslangic  DateTime? @map("baslangic") @db.Date
  bitis      DateTime? @map("bitis") @db.Date
  varsayilan Boolean  @default(false)
  isletme    Isletme  @relation(fields: [isletmeId], references: [id], onDelete: Cascade)
  secenek    StokSecenegi @relation(fields: [secenekId], references: [kimlik], onDelete: Cascade, map: "fiyat_listesi_secenek_baglantisi")

  @@index([isletmeId], map: "fiyat_listesi_ayarlari_isletme_indeks")
  @@map("fiyat_listesi_ayarlari")
}

// ── Bildirimler › Mobil Bildirimler ─────────────────────────────────────────
model Bildirim {
  id               Int      @id @default(autoincrement())
  isletmeId        Int      @map("isletme_id")
  baslik           String   @db.VarChar(60)
  metin            String   @db.VarChar(240)
  gonderimZamani   DateTime @map("gonderim_zamani")
  durum            String   @default("scheduled") @db.VarChar(12)
  otomatik         Boolean  @default(false)
  tumMusteriler    Boolean  @default(true) @map("tum_musteriler")
  olusturmaZamani  DateTime @default(now()) @map("olusturma_zamani")
  guncellemeZamani DateTime @updatedAt @map("guncelleme_zamani")
  isletme          Isletme  @relation(fields: [isletmeId], references: [id], onDelete: Cascade)
  alicilar         BildirimMusterisi[]

  @@index([isletmeId, gonderimZamani], map: "bildirimler_isletme_zaman_indeks")
  @@map("bildirimler")
}

model BildirimMusterisi {
  bildirimId Int      @map("bildirim_id")
  musteriId  Int      @map("musteri_id")
  bildirim   Bildirim @relation(fields: [bildirimId], references: [id], onDelete: Cascade)
  musteri    Musteri  @relation(fields: [musteriId], references: [id], onDelete: Cascade)

  @@id([bildirimId, musteriId])
  @@index([musteriId], map: "bildirim_musterileri_musteri_indeks")
  @@map("bildirim_musterileri")
}

// ── E-ticaret ayarları › Site içeriği ───────────────────────────────────────
model SiteSayfasi {
  id        Int      @id @default(autoincrement())
  isletmeId Int      @map("isletme_id")
  ad        String   @db.VarChar(120)
  slug      String   @db.VarChar(120)
  icerik    String   @db.LongText
  seoBasligi String @default("") @map("seo_basligi") @db.VarChar(250)
  seoAciklamasi String @default("") @map("seo_aciklamasi") @db.VarChar(1000)
