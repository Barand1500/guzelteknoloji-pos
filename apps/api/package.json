{
  "name": "@gt/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed:dev": "tsx --env-file-if-exists=../../.env scripts/seed-dev-user.ts",
    "smtp:check": "tsx --env-file-if-exists=../../.env scripts/check-smtp.ts",
    "db:test:renames": "tsx scripts/check-db-renames.ts",
    "db:test:stock": "tsx scripts/check-stock-db.ts",
    "db:test:stock:browser": "tsx scripts/check-stock-browser.ts"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@gt/shared": "^0.1.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "nodemailer": "^10.3.1",
    "openid-client": "^6.8.9",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  }
}
