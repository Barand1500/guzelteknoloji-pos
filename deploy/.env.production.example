# Sunucudaki .env dosyası için şablon (proje KÖK klasörüne ".env" adıyla koyun).
# Bu dosyadaki boş alanları sunucuda doldurun. Gerçek değerleri repoya/zip'e KOYMAYIN.

NODE_ENV=production

# CloudPanel > Site > Settings > "App Port" neyse AYNISI olmalı (nginx buraya yönlendirir).
PORT=3000

LOG_LEVEL=info

# Sitenin adresi (https zorunlu)
APP_URL=https://pos.guzelteknoloji.com

# nginx (CloudPanel) arkasında gerçek istemci IP'si ve https için
TRUST_PROXY=1

# Derlenmiş web uygulamasını API aynı sunucudan (aynı domainden) sunar. pm2 cwd = apps/api
WEB_DIST_DIR=../web/dist

# CloudPanel > Databases bölümündeki bilgiler. Şifrede özel karakter varsa URL-encode edin
# (ör. @ -> %40, # -> %23, + -> %2B, / -> %2F).
DATABASE_URL=mysql://guzelteknoloji-pos-user:SIFRE@127.0.0.1:3306/guzelteknoloji-pos-db


# Kalıcı dizin; veritabanıyla birlikte yedekleyin.
UPLOADS_DIR=/home/guzelteknoloji-pos/uploads

# En az 32 karakter rastgele. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COOKIE_SECRET=

SESSION_TTL_DAYS=14

# ─── E-posta (giriş kodu) ──────────────────────────────────────────
SMTP_HOST=smtp.guzelteknoloji.com
SMTP_PORT=587
SMTP_USER=destek@guzelteknoloji.com
SMTP_PASS=
MAIL_FROM=Güzel Teknoloji <destek@guzelteknoloji.com>
# SMTP sertifikası kendinden imzalıysa o sertifikanın PEM dosyası (docs/DEPLOY.md > 6. adım)
# SMTP_TLS_CA_FILE=/home/guzelteknoloji-pos/certs/smtp-ca.pem

# ─── Google ile giriş (opsiyonel; boşsa buton "kullanılamıyor" der) ─
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Console > Authorized redirect URI: https://pos.guzelteknoloji.com/api/auth/google/callback

# ─── Yardım iletişim bilgileri (derleme sırasında web uygulamasına gömülür) ─
# "Yardıma Mı İhtiyacınız Var?" penceresinde gömülen destek formunun adresi (https zorunlu).
# Herkese açık bilgidir; derleme sırasında web uygulamasına gömülür, API de CSP frame-src için okur.
# DİKKAT: değiştirirseniz web yeniden derlenmeli (npm run build) ve API yeniden başlatılmalı.
VITE_SUPPORT_TITLE=Yardıma Mı İhtiyacınız Var?
VITE_SUPPORT_FORM_URL=https://destek.guzelteknoloji.com/form/destek?source=3ee65fc2-0dae-45c3-9f7c-b03c1a502254&embed=1

# Apple Developer > Services ID; client secret is an ES256 signed JWT (renew before expiry).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Registered return URL: https://pos.guzelteknoloji.com/api/auth/apple/callback
# APPLE_REDIRECT_URI=https://pos.guzelteknoloji.com/api/auth/apple/callback
