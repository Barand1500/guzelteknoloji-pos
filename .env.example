# Bu dosyayı .env olarak kopyalayın:  cp .env.example .env
# .env asla repoya eklenmez (.gitignore). Buradaki değerler yalnızca ÖRNEKTİR.

# ─── Sunucu (zorunlu) ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Kullanıcının tarayıcıda açtığı adres. Geliştirmede Vite (5173) API'yi /api üzerinden proxy'ler.
# Production: https://alanadiniz.com  (https zorunlu)
APP_URL=http://localhost:5173

# MySQL 8+ / MariaDB 10.6+ bağlantısı. Şifrede özel karakter varsa URL-encode edin.
DATABASE_URL=mysql://kullanici:sifre@localhost:3306/guzel_auth


# Görseller burada özgün biçimlerinde tutulur (API çalışma dizinine göre).
UPLOADS_DIR=../../uploads

# En az 32 karakter rastgele değer. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COOKIE_SECRET=

# Oturum süresi (gün, 1–90)
SESSION_TTL_DAYS=14

# Nginx/CloudPanel gibi bir reverse proxy arkasındaysa 1 yapın (gerçek istemci IP'si için).
TRUST_PROXY=0

# Production'da derlenmiş web uygulamasını API aynı origin'den sunsun (tek site dağıtımı):
# WEB_DIST_DIR=../web/dist

# Yalnızca web ve API farklı domainlerdeyse (ör. api.alanadiniz.com):
# CORS_ORIGINS=https://alanadiniz.com
# COOKIE_DOMAIN=alanadiniz.com

# ─── Google ile giriş (opsiyonel) ──────────────────────────────────
# Boş bırakılırsa Google butonu "şu anda kullanılamıyor" mesajı gösterir.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Varsayılan: ${APP_URL}/api/auth/google/callback — Google Console'daki değerle BİREBİR aynı olmalı.
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# ─── E-posta (giriş kodu gönderimi) ────────────────────────────────
# "E-Posta İle Devam Et" akışında kayıtlı olmayan adreslere 6 haneli kod gönderilir.
# Geliştirmede SMTP boşsa kod e-postaya DEĞİL API konsoluna yazılır. Production'da SMTP zorunludur.
# CloudPanel: Email bölümünden bir posta kutusu açıp bilgileri buraya yazın.
SMTP_HOST=
SMTP_PORT=587
# 465 portunda true, 587'de false (STARTTLS)
# SMTP_SECURE=false
# Sunucu kendinden imzalı TLS sertifikası kullanıyorsa o sertifikanın PEM dosyası (doğrulama kapatılmaz,
# yalnızca bu sertifika güvenilir sayılır). Geçerli sertifika varsa boş bırakın.
# SMTP_TLS_CA_FILE=./certs/smtp-ca.pem
SMTP_USER=
SMTP_PASS=
# İşletmeye ait IMAP kaydı yoksa kullanılacak ortak bağlantı (isteğe bağlı).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
# SMTP_HOST doluysa zorunlu. Ör: Güzel Teknoloji <destek@guzelteknoloji.com>
MAIL_FROM=

# ─── Yardım iletişim bilgileri (herkese açık, gizli değil) ──────────
# "Yardıma Mı İhtiyacınız Var?" penceresinde gömülen destek formunun adresi (https zorunlu).
# Herkese açık bilgidir; derleme sırasında web uygulamasına gömülür, API de CSP frame-src için okur.
# DİKKAT: değiştirirseniz web yeniden derlenmeli (npm run build) ve API yeniden başlatılmalı.
VITE_SUPPORT_TITLE=Yardıma Mı İhtiyacınız Var?
VITE_SUPPORT_FORM_URL=https://destek.guzelteknoloji.com/form/destek?source=3ee65fc2-0dae-45c3-9f7c-b03c1a502254&embed=1
# Boş bırakılan kanal gizlenir; hiçbiri yoksa "henüz eklenmedi" durumu gösterilir.
# Değiştirince dev sunucusu yeniden başlatılmalı / web yeniden derlenmeli.

# Web ve API ayrı domaindeyse API adresi (tek origin'de boş bırakın):
# VITE_API_BASE_URL=https://api.alanadiniz.com

# ─── Yalnızca geliştirme seed kullanıcısı (npm run db:seed:dev) ─────
# SEED_USER_EMAIL=deneme@example.com
# SEED_USER_PASSWORD=
# SEED_USER_NAME=Deneme Kullanıcı

# Apple Developer > Services ID; client secret is an ES256 signed JWT (renew before expiry).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Robot doğrulaması varsayılanı: none | cloudflare | recaptcha
# İşletmenin veritabanında açık/kapalı tercihi yoksa kullanılır. Gizli anahtarlar VITE_ ile başlamaz.
ROBOT_PROVIDER=none
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Registered return URL: https://pos.guzelteknoloji.com/api/auth/apple/callback
# APPLE_REDIRECT_URI=https://pos.guzelteknoloji.com/api/auth/apple/callback
